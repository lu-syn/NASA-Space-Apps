{
  "name": "astro-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Ground station for the Astronaut Radiation & Health Monitor: stores synced readings in Cloudflare D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply astro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply astro-db --remote"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
